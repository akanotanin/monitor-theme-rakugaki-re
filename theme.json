{
  "name": "rakugaki re",
  "short": "rakugaki-re",
  "description": "极简探针（Monitor）的手绘涂鸦本主题：整站是一本摊开的笔记本 —— 虚线手绘边框、标记笔配色、胶带与图钉，节点钉在一张手绘的世界地图上。",
  "version": "1.1.1",
  "author": "akanotanin",
  "url": "https://github.com/akanotanin/monitor-theme-rakugaki-re",
  "config": [
    {
      "type": "title",
      "label": "列表与卡片"
    },
    {
      "type": "boolean",
      "key": "mapOn",
      "label": "节点地图",
      "default": false,
      "help": "列表页顶部那张手绘世界地图；默认关着，打开后整块才渲染（顶栏那枚显隐开关也一起出现，访客可自行收起）。"
    },
    {
      "type": "select",
      "key": "listTop",
      "label": "列表页顶部",
      "default": "both",
      "options": [
        {
          "value": "none",
          "label": "都不显示"
        },
        {
          "value": "groups",
          "label": "只显示分组标签"
        },
        {
          "value": "summary",
          "label": "只显示概览便签"
        },
        {
          "value": "both",
          "label": "两个都显示"
        }
      ],
      "help": "分组标签行与概览便签各要哪一档。"
    },
    {
      "type": "select",
      "key": "cardStyle",
      "label": "卡片形态",
      "default": "doodle",
      "options": [
        {
          "value": "doodle",
          "label": "涂鸦卡片：一台一张手绘卡片，读数最全"
        },
        {
          "value": "checklist",
          "label": "清单表格：一行一台的待办清单，密度最高"
        }
      ],
      "help": "访客默认看到的样式；访客可在顶栏自行更换。"
    },
    {
      "type": "title",
      "label": "节点信息"
    },
    {
      "type": "select",
      "key": "remarkPlacement",
      "label": "备注显示位置",
      "default": "both",
      "options": [
        {
          "value": "both",
          "label": "卡片与详情页都显示"
        },
        {
          "value": "card",
          "label": "只在卡片上显示"
        },
        {
          "value": "detail",
          "label": "只在整页详情里显示"
        },
        {
          "value": "none",
          "label": "都不显示"
        }
      ],
      "help": "备注在后台节点里填（公开给访客、私有给自己）；逗号分隔＝多枚标签，留空＝不显示。"
    },
    {
      "type": "text",
      "key": "pingLines",
      "label": "显示的延迟线路",
      "default": "",
      "help": "每行一个 ping 任务名，最多三条；留空自动取前三条。"
    },
    {
      "type": "title",
      "label": "外观"
    },
    {
      "type": "select",
      "key": "themeMode",
      "label": "主题模式",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": "随系统设置"
        },
        {
          "value": "auto",
          "label": "随北京时间自动切换"
        },
        {
          "value": "light",
          "label": "亮色（纸面）"
        },
        {
          "value": "dark",
          "label": "暗色（黑板）"
        }
      ],
      "help": "站点明暗；按北京时间自动那档＝19:00–07:00 用暗色（访客可自行覆盖）。"
    }
  ]
}
